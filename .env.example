# PayQR frontend — environment
#
# Every NEXT_PUBLIC_ value is BAKED INTO THE BUILD and visible to anyone who
# opens the app. Nothing here is a server secret. Rebuild after any change.
#
# Each entry says:  WHAT it is · WHY we need it · IF WRONG, what happens.

# ═══ 1. thirdweb — merchant login + smart wallets ═══════════════════════

# WHAT: the MERCHANT app's thirdweb client id (the ORIGINAL project, 04efc…).
# WHY:  email/social login and each merchant's gas-free smart wallet.
# IF CHANGED: every merchant gets a NEW, EMPTY wallet address — their funds
#             look lost. Never change it. Restrict it to your domains in the
#             thirdweb dashboard.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# WHAT: thirdweb's default Account Factory v0.7 (public address).
# WHY:  merchant wallet addresses are derived from it.
# IF CHANGED: same as above — every merchant address changes. Never change it.
NEXT_PUBLIC_ACCOUNT_FACTORY=0x4bE0ddfebcA9A5A4a617dee4DeCe99E7c862dceb

# ═══ 2. Chain ═══════════════════════════════════════════════════════════

# WHAT: "baseSepolia" (testnet) or "base" (mainnet).
# IF WRONG: the app reads and writes on the wrong network.
NEXT_PUBLIC_CHAIN=baseSepolia

# WHAT: RPC the browser reads the chain through (use a keyed one).
# IF WRONG: balances and links fail to load. Public RPCs rate-limit (429).
NEXT_PUBLIC_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ═══ 3. Contracts (public addresses) ════════════════════════════════════

# WHAT: the CURRENT MerchantTerminalIntegrator — where all NEW activity goes
#       (registration, sales, links, withdrawals).
# IF WRONG: registration and every sale fail.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x4c4223DdfD0cc1a252013FBA4b8444eECda8A236

# WHAT: the price contract sales are priced against. Deployed WITH the
#       integrator — must be the one from the same deployment.
# IF WRONG: every sale is priced wrong or reverts (ProductNotFound).
NEXT_PUBLIC_CLIENT_ADDRESS=0x8991b470a6Bf6886e9D3f9d60216Acf3CD8D4035

# WHAT: every OLDER integrator, comma-separated, NEWEST FIRST.
# WHY:  an upgrade deploys a new contract; merchants' money and history stay on
#       the old one. With this set, the whole app spans all of them:
#         • dashboard + withdraw: balances counted and withdrawable
#         • transactions, payment links, receipts: full history, from the subgraph
#         • old links are listed read-only; a customer opening one is told to
#           ask for a new link instead of "doesn't exist"
# HOW:  on each upgrade, PREPEND the address being replaced. Never remove one
#       while any merchant still holds money on it.
# IF MISSING: merchants' old balances and history disappear from the app (the
#             money itself is safe on-chain).
NEXT_PUBLIC_PREV_CONTRACT_ADDRESSES=0x2Edcf5E918F181d8CE5b15827a78Ebd83A0efDd6,0x10A08aa7D5078C7210Ba848941ACC36982701eAf
# Older single-address form. Still honoured (merged into the list); leave empty.
NEXT_PUBLIC_PREV_CONTRACT_ADDRESS=

# WHAT: the LinkRouter paired with NEXT_PUBLIC_CONTRACT_ADDRESS.
# WHY:  it is the EIP-712 verifyingContract customers sign "I have paid" for.
# IF WRONG: every customer signature is rejected (BadCustomerSignature) even
#           though nothing else looks broken.
NEXT_PUBLIC_LINK_ROUTER_ADDRESS=0xD273e0DE53C3f5516c7e8FE2feD1e1782FA3Fae7

# WHAT: the p2p.me protocol Diamond and its USDC on this chain.
# IF WRONG: orders, rates and balances all fail.
NEXT_PUBLIC_DIAMOND_ADDRESS=0xeb0BB8E3c014D915D9B2df03aBB130a1Fb44beb9
NEXT_PUBLIC_USDC_ADDRESS=0x4095fE4f1E636f11A95820BA2bB87F335Bd1040d

# ═══ 4. Subgraph ════════════════════════════════════════════════════════

# WHAT: the p2p.me subgraph (protocol-wide order index).
# WHY:  all transaction / payment-link / withdrawal HISTORY and receipts come
#       from here — across every contract above — plus automatic circle
#       (LP group) selection. Queries are always scoped to PayQR's contracts,
#       so orders from other apps on the protocol never show.
# IF WRONG: history is empty or shows "couldn't load"; sales can't pick a circle.
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1745491/event-indexer/v0.0.6

# ═══ 5. Relayer (payment links) ═════════════════════════════════════════

# WHAT: base URL of the relayer service on Railway (no trailing slash).
#       Local: http://localhost:8787
# WHY:  walletless customers pay links through it.
# IF EMPTY: payment links are switched off (the pages say "not configured").
# IF WRONG: link payments and link creation fail.
NEXT_PUBLIC_RELAYER_WORKER_URL=

# WHAT: canonical origin for shareable /pay links, e.g. https://pay.payqr.app
# WHY:  every shared link points at ONE domain, whichever domain the merchant
#       dashboard was opened from.
# IF EMPTY: uses the current site's origin (fine locally).
NEXT_PUBLIC_PAY_BASE_URL=

# ═══ 6. OPTIONAL — p2p.me services ══════════════════════════════════════

# Fraud screening for sales. All three set = on; all blank = off.
# The key must match the fraud engine's SEON_ENCRYPTION_KEY for this environment.
# IF WRONG: screening calls fail; B2B-screening merchants reject those orders.
NEXT_PUBLIC_FRAUD_ENGINE_API_URL=
NEXT_PUBLIC_FRAUD_ENGINE_ENCRYPTION_KEY=
NEXT_PUBLIC_FRAUD_ENGINE_ORDER_SOURCE=payqr-checkout

# Dispute support bridge (per-order support chat). Blank = feature hidden.
NEXT_PUBLIC_SUPPORT_BRIDGE_URL=

# P2P ecosystem app store shown in the app. Blank = https://p2p.store
NEXT_PUBLIC_ECOSYSTEM_URL=

# ═══ BASE MAINNET ═══════════════════════════════════════════════════════
# For a mainnet build, set these instead of the testnet values above.
# next.config.mjs REFUSES to build a mainnet app that is missing one of the
# required values or still has a testnet address or RPC in it.
#
# NEXT_PUBLIC_CHAIN=base
# NEXT_PUBLIC_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<KEY>
# NEXT_PUBLIC_CONTRACT_ADDRESS=<mainnet MerchantTerminalIntegrator>
# NEXT_PUBLIC_LINK_ROUTER_ADDRESS=<mainnet LinkRouter>
# NEXT_PUBLIC_CLIENT_ADDRESS=<mainnet price client>
# NEXT_PUBLIC_DIAMOND_ADDRESS=<p2p.me Diamond on Base mainnet>
# NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   # Base USDC (required exactly)
# NEXT_PUBLIC_SUBGRAPH_URL=<mainnet subgraph>                           # required: no testnet fallback
# NEXT_PUBLIC_RELAYER_WORKER_URL=<mainnet relayer, no trailing slash>
# NEXT_PUBLIC_PAY_BASE_URL=<the app's public URL, e.g. https://app.payqr.pro>
# NEXT_PUBLIC_PREV_CONTRACT_ADDRESSES=                                  # empty unless there are OLDER MAINNET integrators
# NEXT_PUBLIC_THIRDWEB_CLIENT_ID / NEXT_PUBLIC_ACCOUNT_FACTORY: keep the SAME values —
#   changing either gives every user a new wallet.
# Fraud-engine and support-bridge values: the MAINNET ones.
