# thirdweb Client ID (thirdweb.com/dashboard → project → Settings → Client ID).
# Account Abstraction is enabled by default on testnet with a valid Client ID, so
# merchant transactions are gasless on Base Sepolia. Public value, but restrict it
# to your domain(s) in the dashboard.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# OPTIONAL — custom ERC-4337 account factory (public on-chain address). When set,
# merchant smart-account addresses derive from THIS factory instead of thirdweb's
# default. Changing it AFTER merchants exist changes their addresses (and strands
# funds keyed to the old ones), so set it once, up front. Leave blank to use the
# thirdweb default factory.
NEXT_PUBLIC_ACCOUNT_FACTORY=

# The app runs live on Base Sepolia (the p2p.me protocol's testnet).
NEXT_PUBLIC_CHAIN=baseSepolia
NEXT_PUBLIC_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployed MerchantTerminalIntegrator + its price client
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CLIENT_ADDRESS=

# OPTIONAL — ONLY set this when you UPGRADE to a new integrator. Put the OLD
# integrator address here (and the new one in NEXT_PUBLIC_CONTRACT_ADDRESS above).
# The withdraw page then shows a "Previous terminal balance" card so merchants can
# drain funds they still hold on the old contract (including funds that were locked
# and unlock after the switch). Leave BLANK in steady state — the feature is dormant
# when empty. Clear it again once the old contract has been fully drained/retired.
NEXT_PUBLIC_PREV_CONTRACT_ADDRESS=

# p2p.me protocol addresses on Base Sepolia
NEXT_PUBLIC_DIAMOND_ADDRESS=0xeb0BB8E3c014D915D9B2df03aBB130a1Fb44beb9
NEXT_PUBLIC_USDC_ADDRESS=0x4095fE4f1E636f11A95820BA2bB87F335Bd1040d

# Subgraph for automatic INR circle selection
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1745491/event-indexer/v0.0.6

# OPTIONAL — B2B fraud screening (@p2pdotme/widgets <Checkout screening={...}>).
# Logs every buy attempt to the p2p.me fraud engine and links the on-chain
# orderId back, so the merchant app's /order-statuses lookup sees the order as
# screened+approved. Leave both blank to disable screening entirely — the
# widget then places orders with no screening metadata (merchants serving B2B
# orders will reject them, everyone else is unaffected).
# Base URL INCLUDING the /api/v1 prefix (e.g. https://fe.p2p.lol/api/v1).
NEXT_PUBLIC_FRAUD_ENGINE_API_URL=
# 64-char hex AES-256-GCM key. Must match the backend's SEON_ENCRYPTION_KEY
# for this environment.
NEXT_PUBLIC_FRAUD_ENGINE_ENCRYPTION_KEY=
# Free-form analytics tag stored on each activity log.
NEXT_PUBLIC_FRAUD_ENGINE_ORDER_SOURCE=payqr-checkout

# OPTIONAL — per-order dispute support (@p2pdotme/widgets/support). p2p.me-hosted
# bridge URL for the Transactions page's Dispute Manager (live dispute status +
# per-order support chat). Leave blank in steady state — the feature stays
# dormant (no bridge calls, chip doesn't render) until p2p.me hands this over
# for your environment. See INTEGRATOR_SUPPORT_GUIDE.md.
NEXT_PUBLIC_SUPPORT_BRIDGE_URL=
